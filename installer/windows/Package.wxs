<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="$(var.AppName)"
           Manufacturer="$(var.Manufacturer)"
           Version="$(var.AppVersion)"
           UpgradeCode="$(var.UpgradeCode)"
           Scope="perMachine"
           Language="1033">

    <SummaryInformation Description="$(var.AppName) Windows Installer"
                        Manufacturer="$(var.Manufacturer)" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Application Icon & Add/Remove Programs Metadata -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="$(var.RepoUrl)" />
    <Property Id="ARPHELPLINK" Value="$(var.RepoUrl)/issues" />

    <!-- Standard Install-Directory Setup Wizard UI -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtfPath)" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />

    <!-- Target Directories -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="$(var.AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="$(var.AppName)" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Main Executable Component -->
    <Component Id="MainExecutableComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="UniversalDownloaderExe"
            Name="UniversalDownloader.exe"
            Source="$(var.ExePath)"
            KeyPath="yes" />
    </Component>

    <!-- Start Menu Shortcut -->
    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="B7E4F321-8C42-4B9E-A5D6-71F9C8E24A11">
      <Shortcut Id="StartMenuShortcut"
                Name="$(var.AppName)"
                Description="Download video and audio from 1,000+ platforms"
                Target="[#UniversalDownloaderExe]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\$(var.Manufacturer)\UniversalDownloader"
                     Name="StartMenuInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Desktop Shortcut -->
    <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="C9A1E853-2F14-4D6A-8E7B-39C4D1B62F05">
      <Shortcut Id="DesktopShortcut"
                Name="$(var.AppName)"
                Description="Download video and audio from 1,000+ platforms"
                Target="[#UniversalDownloaderExe]"
                WorkingDirectory="INSTALLFOLDER"
                Icon="AppIcon.ico" />
      <RegistryValue Root="HKCU"
                     Key="Software\$(var.Manufacturer)\UniversalDownloader"
                     Name="DesktopShortcutInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <!-- Custom udloader:// & downloader:// URL Protocol Handlers -->
    <Component Id="ProtocolHandlerComponent" Directory="INSTALLFOLDER" Guid="D4F8A217-9E35-4C1B-B6A2-58E1C9F73A44">
      <RegistryKey Root="HKLM" Key="Software\Classes\udloader">
        <RegistryValue Type="string" Value="URL:Universal Media Downloader Protocol" KeyPath="yes" />
        <RegistryValue Name="URL Protocol" Type="string" Value="" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="&quot;[#UniversalDownloaderExe]&quot;,0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[#UniversalDownloaderExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="Software\Classes\downloader">
        <RegistryValue Type="string" Value="URL:Universal Media Downloader Protocol" />
        <RegistryValue Name="URL Protocol" Type="string" Value="" />
        <RegistryKey Key="DefaultIcon">
          <RegistryValue Type="string" Value="&quot;[#UniversalDownloaderExe]&quot;,0" />
        </RegistryKey>
        <RegistryKey Key="shell\open\command">
          <RegistryValue Type="string" Value="&quot;[#UniversalDownloaderExe]&quot; &quot;%1&quot;" />
        </RegistryKey>
      </RegistryKey>
    </Component>

    <Feature Id="MainApplication" Title="$(var.AppName)" Level="1">
      <ComponentRef Id="MainExecutableComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
      <ComponentRef Id="ProtocolHandlerComponent" />
    </Feature>
  </Package>
</Wix>
