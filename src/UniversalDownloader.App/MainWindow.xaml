<Window x:Class="UniversalDownloader.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Universal Media Downloader"
        Icon="Assets/app-icon.ico"
        Height="720" Width="1020"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Universal Media Downloader" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="High-speed C# native client powered by Python/yt-dlp backend" FontSize="13" Foreground="{StaticResource SubtextBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#27272A" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text=".NET 9 Native" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- TAB 1: DOWNLOAD -->
            <TabItem Header="Download">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,15,0,0">

                        <!-- URL Input Card -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Media or Profile URL" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UrlTextBox" Grid.Column="0" FontSize="14" VerticalContentAlignment="Center" KeyDown="UrlTextBox_KeyDown"/>
                                    <Button x:Name="PasteButton" Grid.Column="1" Content="Paste" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="PasteButton_Click"/>
                                    <Button x:Name="InspectButton" Grid.Column="2" Content="Inspect Formats" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="InspectButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Download Options Card -->
                        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Download Options" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Quality Selector -->
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Target Quality" Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="QualityComboBox" SelectedIndex="0" Padding="8,6" Background="#18181B" Foreground="{StaticResource TextBrush}">
                                            <ComboBoxItem Content="Best Available (Max)"/>
                                            <ComboBoxItem Content="1080p Full HD"/>
                                            <ComboBoxItem Content="720p HD"/>
                                            <ComboBoxItem Content="480p SD"/>
                                            <ComboBoxItem Content="Audio Only"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Codec Preference -->
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="Preferred Codec" Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="CodecComboBox" SelectedIndex="0" Padding="8,6" Background="#18181B" Foreground="{StaticResource TextBrush}">
                                            <ComboBoxItem Content="Default (Auto)"/>
                                            <ComboBoxItem Content="H.264 / AVC1 (Universal GPU)"/>
                                            <ComboBoxItem Content="VP9 (High Quality)"/>
                                            <ComboBoxItem Content="AV1 (Ultra Compressed)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Audio Format (if audio only) -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Audio Codec (if audio)" Foreground="{StaticResource SubtextBrush}" FontSize="12" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="AudioFormatComboBox" SelectedIndex="0" Padding="8,6" Background="#18181B" Foreground="{StaticResource TextBrush}">
                                            <ComboBoxItem Content="MP3 (192k)"/>
                                            <ComboBoxItem Content="MP3 High (320k)"/>
                                            <ComboBoxItem Content="M4A / AAC"/>
                                            <ComboBoxItem Content="FLAC (Lossless)"/>
                                            <ComboBoxItem Content="Best (Keep Stream)"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Feature Checkboxes -->
                                <WrapPanel Margin="0,6,0,12">
                                    <CheckBox x:Name="EmbedMetadataCheck" Content="Embed Metadata Tags" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                    <CheckBox x:Name="EmbedThumbnailCheck" Content="Embed Cover Artwork" IsChecked="True" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                    <CheckBox x:Name="EmbedSubsCheck" Content="Embed Subtitles" IsChecked="False" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                    <CheckBox x:Name="WriteThumbnailCheck" Content="Save Thumbnail File" IsChecked="False" Foreground="{StaticResource TextBrush}" Margin="0,0,20,0"/>
                                </WrapPanel>

                                <!-- Time Slicing -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start Time:" Foreground="{StaticResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="StartTimeBox" Grid.Column="1" ToolTip="e.g. 00:01:30" Margin="0,0,16,0"/>
                                    <TextBlock Grid.Column="2" Text="End Time:" Foreground="{StaticResource SubtextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="EndTimeBox" Grid.Column="3" ToolTip="e.g. 00:03:00"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Bar -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="DownloadButton" Grid.Column="0" Content="Start Download" FontSize="15" Padding="20,12" Click="DownloadButton_Click"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="10,0,0,0" Style="{StaticResource DangerButton}" Padding="16,12" IsEnabled="False" Click="CancelButton_Click"/>
                        </Grid>

                        <!-- Progress Display Card -->
                        <Border x:Name="ProgressCard" Visibility="Collapsed" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock x:Name="StatusLabel" Text="Downloading media..." FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock x:Name="PercentLabel" Text="0.0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                                </Grid>

                                <ProgressBar x:Name="DownloadProgressBar" Height="10" Value="0" Maximum="100" Background="#18181B" Foreground="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,0,0,8"/>

                                <Grid>
                                    <TextBlock x:Name="DetailsLabel" Text="0 B / 0 B • 0 B/s" FontSize="12" Foreground="{StaticResource SubtextBrush}"/>
                                    <TextBlock x:Name="EtaLabel" Text="ETA: --:--" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource SubtextBrush}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Formats Inspection Table -->
                        <Border x:Name="FormatsCard" Visibility="Collapsed" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Available Streams &amp; Resolutions" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                                <DataGrid x:Name="FormatsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="220" Background="#18181B" Foreground="{StaticResource TextBrush}" RowBackground="#1E1E24" AlternatingRowBackground="#24242C" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Format ID" Binding="{Binding FormatId}" Width="90"/>
                                        <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution}" Width="120"/>
                                        <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" Width="80"/>
                                        <DataGridTextColumn Header="FPS" Binding="{Binding Fps}" Width="60"/>
                                        <DataGridTextColumn Header="Video Codec" Binding="{Binding VCodec}" Width="120"/>
                                        <DataGridTextColumn Header="Audio Codec" Binding="{Binding ACodec}" Width="120"/>
                                        <DataGridTextColumn Header="Note" Binding="{Binding FormatNote}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: HISTORY -->
            <TabItem Header="History">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- History Search Bar -->
                    <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="HistorySearchBox" Grid.Column="0" FontSize="13" VerticalContentAlignment="Center" KeyDown="HistorySearchBox_KeyDown"/>
                            <Button x:Name="HistorySearchButton" Grid.Column="1" Content="Search" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="HistorySearchButton_Click"/>
                            <Button x:Name="HistoryRefreshButton" Grid.Column="2" Content="Refresh" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="HistoryRefreshButton_Click"/>
                            <Button x:Name="HistoryClearButton" Grid.Column="3" Content="Clear All" Margin="8,0,0,0" Style="{StaticResource DangerButton}" Click="HistoryClearButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- History List -->
                    <DataGrid x:Name="HistoryDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Background="{StaticResource CardBgBrush}" Foreground="{StaticResource TextBrush}" RowBackground="#1E1E24" AlternatingRowBackground="#24242C" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateFormatted}" Width="150"/>
                            <DataGridTextColumn Header="Platform" Binding="{Binding Platform}" Width="90"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Uploader" Binding="{Binding Uploader}" Width="140"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTemplateColumn Header="Actions" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Open" Margin="2" Padding="8,4" Click="OpenMediaFile_Click"/>
                                            <Button Content="Show Folder" Margin="2" Padding="8,4" Style="{StaticResource SecondaryButton}" Click="ShowFolder_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: SETTINGS -->
            <TabItem Header="Settings">
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,15,0,0">
                    <StackPanel MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Application Settings" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                        <!-- Output Directory -->
                        <TextBlock Text="Download Directory" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DownloadDirBox" Grid.Column="0" Text="downloads" VerticalContentAlignment="Center"/>
                            <Button x:Name="BrowseDirButton" Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="BrowseDirButton_Click"/>
                        </Grid>

                        <!-- Proxy -->
                        <TextBlock Text="Proxy Server (Optional)" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="ProxyBox" Margin="0,0,0,16" ToolTip="e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:8080"/>

                        <!-- Bandwidth Limit -->
                        <TextBlock Text="Bandwidth Limit" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="LimitRateBox" Margin="0,0,0,16" ToolTip="e.g. 5M, 500K"/>

                        <!-- Browser Profile Cookies -->
                        <TextBlock Text="Browser Cookies Extraction" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="BrowserCookiesComboBox" SelectedIndex="0" Padding="8,6" Background="#18181B" Foreground="{StaticResource TextBrush}" Margin="0,0,0,20">
                            <ComboBoxItem Content="None (Public Downloads Only)"/>
                            <ComboBoxItem Content="Chrome"/>
                            <ComboBoxItem Content="Edge"/>
                            <ComboBoxItem Content="Firefox"/>
                            <ComboBoxItem Content="Brave"/>
                        </ComboBox>

                        <!-- Windows Protocol Registration Button -->
                        <Button x:Name="RegisterProtocolButton" Content="Register 'downloader://' Browser Protocol" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="RegisterProtocolButton_Click"/>
                    </StackPanel>
                </Border>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,16,0,0">
            <TextBlock x:Name="GlobalStatusText" Text="Ready" Foreground="{StaticResource SubtextBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
