<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationTitle>Universal Media Downloader (Avalonia)</ApplicationTitle>
    <AssemblyName>UniversalDownloader</AssemblyName>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalDownloader.Core\UniversalDownloader.Core.csproj" />
  </ItemGroup>

  <!-- Embed compiled standalone backend and optional media engines for all-in-one distribution -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\downloader.exe')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\downloader.exe">
      <LogicalName>downloader.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\downloader')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\downloader">
      <LogicalName>downloader</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\ffmpeg.exe')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\ffmpeg.exe">
      <LogicalName>ffmpeg.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\ffprobe.exe')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\ffprobe.exe">
      <LogicalName>ffprobe.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\ffmpeg')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\ffmpeg">
      <LogicalName>ffmpeg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\dist\ffprobe')">
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\dist\ffprobe">
      <LogicalName>ffprobe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
