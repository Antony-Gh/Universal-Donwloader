<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UniversalDownloader.Avalonia.QuickDownloadWindow"
        Title="Quick Download HUD"
        Width="580" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Topmost="True"
        Background="#0F1117">

    <Window.Resources>
        <StreamGeometry x:Key="CloseIcon">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</StreamGeometry>
        <StreamGeometry x:Key="CopyIcon">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
        <StreamGeometry x:Key="VideoIcon">M17,10.5V7A1,1 0 0,0 16,6H4A1,1 0 0,0 3,7V17A1,1 0 0,0 4,18H16A1,1 0 0,0 17,17V13.5L21,17.5V6.5L17,10.5Z</StreamGeometry>
        <StreamGeometry x:Key="MusicNoteIcon">M12,3V13.55C11.41,13.21 10.73,13 10,13A4,4 0 0,0 6,17A4,4 0 0,0 10,21A4,4 0 0,0 14,17V7H18V3H12Z</StreamGeometry>
        <StreamGeometry x:Key="QueueIcon">M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z</StreamGeometry>
    </Window.Resources>

    <Border BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="10" Padding="18">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="HUD" Foreground="#93C5FD" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="HudTitleText" Text="Quick Download HUD" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                    </StackPanel>
                    <TextBlock x:Name="HudSubtitleText" Text="Instant download or queue from anywhere (Ctrl+Shift+D)" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="1" Padding="8,4" Background="Transparent" Foreground="#64748B" FontSize="14" Click="CloseButton_Click" ToolTip.Tip="Close (Esc)">
                    <PathIcon Data="{StaticResource CloseIcon}" Width="11" Height="11" Foreground="#64748B"/>
                </Button>
            </Grid>

            <!-- URL Input Bar -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <TextBox x:Name="HudUrlTextBox" Grid.Column="0"
                         FlowDirection="LeftToRight"
                         FontSize="13"
                         Watermark="Paste video/playlist URL here..."
                         Background="#181824" Foreground="#F8FAFC"
                         BorderBrush="#334155"
                         CornerRadius="6,0,0,6"/>
                <Button x:Name="HudPasteButton" Grid.Column="1"
                        Padding="12,8"
                        Background="#27272A" Foreground="#38BDF8"
                        FontWeight="SemiBold" FontSize="12"
                        CornerRadius="0,6,6,0"
                        Click="HudPasteButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource CopyIcon}" Width="12" Height="12" Foreground="#38BDF8"/>
                        <TextBlock x:Name="HudPasteText" Text="Paste" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Options Row -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" Margin="0,0,0,14">
                <!-- Quality -->
                <StackPanel Grid.Column="0" Margin="0,0,6,0" Spacing="4">
                    <TextBlock x:Name="HudFormatQualityLabel" Text="Format &amp; Quality:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox x:Name="HudQualityCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="Best Available (Video)"/>
                        <ComboBoxItem Content="1080p Full HD (Video)"/>
                        <ComboBoxItem Content="720p HD (Video)"/>
                        <ComboBoxItem Content="480p SD (Video)"/>
                        <ComboBoxItem Content="Audio (MP3 320k)"/>
                        <ComboBoxItem Content="Audio (M4A Best)"/>
                        <ComboBoxItem Content="Audio (FLAC Lossless)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Preset -->
                <StackPanel Grid.Column="1" Margin="6,0,0,0" Spacing="4">
                    <TextBlock x:Name="HudPresetLabel" Text="Social / Device Preset:" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <ComboBox x:Name="HudPresetCombo" HorizontalAlignment="Stretch" SelectedIndex="0">
                        <ComboBoxItem Content="None (Standard)"/>
                        <ComboBoxItem Content="Discord (&lt;25 MB)"/>
                        <ComboBoxItem Content="Discord Nitro (&lt;10 MB)"/>
                        <ComboBoxItem Content="WhatsApp (&lt;16 MB)"/>
                        <ComboBoxItem Content="Car Audio (MP3 Normalized)"/>
                        <ComboBoxItem Content="TV Theater (4K/Surround)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Action Buttons Grid -->
            <Grid Grid.Row="3" ColumnDefinitions="*,*,*" Margin="0,0,0,12">
                <Button x:Name="HudDownloadVideoButton" Grid.Column="0" Margin="0,0,4,0"
                        Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12"
                        CornerRadius="6"
                        Click="HudDownloadVideoButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource VideoIcon}" Width="14" Height="14" Foreground="White"/>
                        <TextBlock x:Name="HudDownloadVideoText" Text="Download Video" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="HudDownloadAudioButton" Grid.Column="1" Margin="4,0,4,0"
                        Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#059669" Foreground="White" FontWeight="Bold" FontSize="12"
                        CornerRadius="6"
                        Click="HudDownloadAudioButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource MusicNoteIcon}" Width="14" Height="14" Foreground="White"/>
                        <TextBlock x:Name="HudDownloadAudioText" Text="Download Audio" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="HudQueueButton" Grid.Column="2" Margin="4,0,0,0"
                        Padding="0,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Background="#D97706" Foreground="White" FontWeight="Bold" FontSize="12"
                        CornerRadius="6"
                        Click="HudQueueButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <PathIcon Data="{StaticResource QueueIcon}" Width="14" Height="14" Foreground="White"/>
                        <TextBlock x:Name="HudQueueText" Text="Add to Queue" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Status Banner -->
            <Border x:Name="HudStatusBorder" Grid.Row="4" IsVisible="False"
                    Background="#1E293B" BorderBrush="#475569" BorderThickness="1"
                    CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                <TextBlock x:Name="HudStatusText" Text="" Foreground="#E2E8F0" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
            </Border>

            <!-- Footer / Tip -->
            <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="HudTipText" Grid.Column="0" Text="Tip: Press Enter to download video immediately, or Esc to dismiss."
                           FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                <Button x:Name="HudDismissButton" Grid.Column="1" Padding="10,4" Background="Transparent" Foreground="#94A3B8" FontSize="11"
                        Content="Dismiss" Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
