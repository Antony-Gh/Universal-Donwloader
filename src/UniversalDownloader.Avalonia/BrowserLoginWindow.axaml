<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UniversalDownloader.Avalonia.BrowserLoginWindow"
        Title="Web Login — Automatic Cookie Sync"
        Width="580"
        Height="410"
        MinWidth="500"
        MinHeight="370"
        WindowStartupLocation="CenterOwner"
        Background="#121216"
        Foreground="#F4F4F8"
        CanResize="False">
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,14">
            <TextBlock Text="Sign In via Browser (Automatic Cookie Sync)"
                       FontSize="17" FontWeight="Bold" Foreground="#F4F4F8"/>
            <TextBlock Text="Opens a dedicated, isolated browser login window using your installed Chrome or Edge. Sign in once — your login stays remembered inside the app's own login profile so you never need to copy cookies manually."
                       FontSize="12" Foreground="#9CA3AF" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Body -->
        <StackPanel Grid.Row="1" Spacing="12">
            <!-- Detected browser pill -->
            <Border Background="#181820" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Browser Engine:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BrowserDetectedText" Text="Detecting installed browser..." FontSize="12" FontWeight="SemiBold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Platform selection -->
            <StackPanel Spacing="6">
                <TextBlock Text="1. Choose Platform" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="200,*">
                    <ComboBox x:Name="SiteComboBox" Grid.Column="0" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="SiteComboBox_SelectionChanged">
                        <ComboBoxItem Content="Facebook (facebook.com)"/>
                        <ComboBoxItem Content="Instagram (instagram.com)"/>
                        <ComboBoxItem Content="YouTube (youtube.com)"/>
                        <ComboBoxItem Content="TikTok (tiktok.com)"/>
                        <ComboBoxItem Content="X / Twitter (x.com)"/>
                        <ComboBoxItem Content="Reddit (reddit.com)"/>
                        <ComboBoxItem Content="Custom URL..."/>
                    </ComboBox>
                    <TextBox x:Name="CustomUrlBox" Grid.Column="1" Margin="8,0,0,0"
                             Watermark="e.g. https://example.com/login"
                             IsVisible="False" FlowDirection="LeftToRight"/>
                </Grid>
            </StackPanel>

            <!-- Action Step Buttons -->
            <Border Background="#181820" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="2. Sign In &amp; Sync" FontSize="12" Foreground="#CBD5E1" FontWeight="SemiBold"/>
                    <TextBlock Text="Click 'Open Browser &amp; Sign In', complete login in the popup window, then return here and click 'Sync &amp; Apply Cookies'."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button x:Name="LaunchBrowserButton" Padding="16,9" Background="#2563EB" Foreground="White"
                                FontWeight="SemiBold" Content="Open Browser &amp; Sign In"
                                Click="LaunchBrowserButton_Click"/>
                        <Button x:Name="SyncCookiesButton" Padding="16,9" Background="#10B981" Foreground="White"
                                FontWeight="Bold" Content="Sync &amp; Apply Cookies" IsEnabled="False"
                                Click="SyncCookiesButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="#38BDF8" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <TextBlock Grid.Column="0" Text="Uses isolated app profile • Never modifies your personal Chrome data."
                       FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Padding="14,7" Background="#27272A" Foreground="#CBD5E1"
                    Content="Close" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
