<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:UniversalDownloader.Core.Models;assembly=UniversalDownloader.Core"
        xmlns:local="clr-namespace:UniversalDownloader.Avalonia"
        x:Class="UniversalDownloader.Avalonia.MainWindow"
        Title="Universal Media Downloader"
        Icon="/Assets/app-icon.ico"
        Width="940" Height="740"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E12">

