<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="UniversalDownloader.Avalonia.MainWindow"
        Title="Universal Media Downloader"
        Icon="/Assets/app-icon.ico"
        Width="920" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E12">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="/Assets/app-icon.png" Width="36" Height="36"/>
                <TextBlock Text="Universal Media Downloader" FontSize="20" FontWeight="Bold" Foreground="#F4F4F8" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabControl" Grid.Row="1">
            <!-- DOWNLOAD TAB -->
            <TabItem Header="Download">
                <ScrollViewer Margin="0,15,0,0">
                    <StackPanel Spacing="16">
                        <!-- URL Input Card -->
                        <Border Background="#1E1E24" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Media URL" FontWeight="SemiBold" Foreground="#F4F4F8"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox x:Name="UrlTextBox" Grid.Column="0" Watermark="Paste video, audio, or playlist URL here..."/>
                                    <Button x:Name="PasteButton" Grid.Column="1" Content="📋 Paste" Margin="8,0,0,0" Click="PasteButton_Click"/>
                                    <Button x:Name="InspectButton" Grid.Column="2" Content="🔍 Inspect Streams" Margin="8,0,0,0" Background="#374151" Click="InspectButton_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Options Card -->
                        <Border Background="#1E1E24" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Download Options" FontWeight="SemiBold" Foreground="#F4F4F8"/>
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="6">
                                        <TextBlock Text="Quality" Foreground="#9CA3AF" FontSize="12"/>
                                        <ComboBox x:Name="QualityComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Best Available (Max)"/>
                                            <ComboBoxItem Content="1080p Full HD"/>
                                            <ComboBoxItem Content="720p HD"/>
                                            <ComboBoxItem Content="480p SD"/>
                                            <ComboBoxItem Content="Audio Only (MP3)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="6">
                                        <TextBlock Text="Codec Preference" Foreground="#9CA3AF" FontSize="12"/>
                                        <ComboBox x:Name="CodecComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Default (Auto)"/>
                                            <ComboBoxItem Content="H.264 / AVC1 (Universal)"/>
                                            <ComboBoxItem Content="VP9 (High Quality)"/>
                                            <ComboBoxItem Content="AV1 (Ultra Compressed)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <TextBlock Text="Fragments" Foreground="#9CA3AF" FontSize="12"/>
                                        <NumericUpDown x:Name="FragmentsNumeric" Value="4" Minimum="1" Maximum="16"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Output Directory -->
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <TextBlock Text="Save Directory" Foreground="#9CA3AF" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox x:Name="OutputDirBox" Grid.Column="0" Watermark="Default directory (or ~/Downloads)"/>
                                        <Button x:Name="BrowseDirButton" Grid.Column="1" Content="📁 Browse..." Margin="8,0,0,0" Click="BrowseDirButton_Click"/>
                                        <Button x:Name="OpenDirButton" Grid.Column="2" Content="📂 Open" Margin="8,0,0,0" Background="#374151" Click="OpenDirButton_Click"/>
                                    </Grid>
                                </StackPanel>

                                <WrapPanel Margin="0,6,0,0">
                                    <CheckBox x:Name="EmbedMetadataCheck" Content="Embed Metadata" IsChecked="True" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="EmbedThumbnailCheck" Content="Embed Cover Art" IsChecked="True" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="EmbedSubsCheck" Content="Embed Subtitles" IsChecked="False" Margin="0,0,16,0"/>
                                    <CheckBox x:Name="WriteThumbnailCheck" Content="Save Thumbnail File" IsChecked="False"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action Bar -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Button x:Name="DownloadButton" Grid.Column="0" Content="Start Download" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#6366F1" Foreground="White" Padding="14" FontWeight="Bold" Click="DownloadButton_Click"/>
                            <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Margin="10,0,0,0" Background="#EF4444" Foreground="White" Padding="14" IsEnabled="False" Click="CancelButton_Click"/>
                        </Grid>

                        <!-- Real-time Progress Card -->
                        <Border x:Name="ProgressCard" IsVisible="False" Background="#1E1E24" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="Downloading..." FontWeight="SemiBold" Foreground="#F4F4F8"/>
                                    <TextBlock x:Name="PercentLabel" Grid.Column="1" Text="0.0%" FontWeight="Bold" Foreground="#6366F1"/>
                                </Grid>
                                <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#6366F1"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="DetailsLabel" Grid.Column="0" Text="0 B / 0 B • 0 B/s" FontSize="12" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="EtaLabel" Grid.Column="1" Text="ETA: --:--" FontSize="12" Foreground="#9CA3AF"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Inline Terminal Logs -->
                        <Border Background="#1E1E24" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Live Terminal Output" FontWeight="SemiBold" Foreground="#F4F4F8"/>
                                    <Button x:Name="QuickCopyLogsButton" Grid.Column="1" Content="📋 Copy Output" Padding="10,4" FontSize="11" Background="#27272A" Foreground="#E2E8F0" Click="QuickCopyLogsButton_Click"/>
                                </Grid>
                                <Border Background="#090A0F" CornerRadius="6" BorderBrush="#27272A" BorderThickness="1" Padding="8" MaxHeight="150">
                                    <TextBox x:Name="QuickLogBox"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                             FontSize="11"
                                             Foreground="#86EFAC"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- STREAMS EXPLORER TAB -->
            <TabItem x:Name="StreamsTab" Header="Streams">
                <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,15,0,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="StreamsStatusHeader" Grid.Column="0" Text="Inspect a media URL on the Download tab to view all formats." FontWeight="SemiBold" Foreground="#F4F4F8" VerticalAlignment="Center"/>
                            <Button x:Name="RefreshStreamsButton" Grid.Column="1" Content="🔄 Refresh Streams" Padding="10,6" Background="#374151" Foreground="White" Click="InspectButton_Click"/>
                        </Grid>

                        <ListBox x:Name="StreamsListBox" MaxHeight="450" Background="#18181B">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="120,80,*,120,Auto" Margin="6,4">
                                        <!-- Resolution / Type -->
                                        <TextBlock Grid.Column="0" Text="{Binding ResolutionFormatted}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#A7F3D0"/>
                                        <!-- Extension & ID -->
                                        <TextBlock Grid.Column="1" Text="{Binding Extension}" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                        <!-- Codecs & Note -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CodecSummary}" Foreground="#F4F4F8" FontSize="12"/>
                                            <TextBlock Text="{Binding FormatNote}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- File size -->
                                        <TextBlock Grid.Column="3" Text="{Binding FilesizeFormatted}" VerticalAlignment="Center" Foreground="#CBD5E1" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                        <!-- Download button -->
                                        <Button Grid.Column="4" Content="⚡ Download" Padding="10,5" Background="#6366F1" Foreground="White" FontWeight="SemiBold" FontSize="11" Click="DownloadStream_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- HISTORY TAB -->
            <TabItem Header="History">
                <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,15,0,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBox x:Name="HistorySearchBox" Grid.Column="0" Watermark="Search history..."/>
                            <Button x:Name="HistorySearchButton" Grid.Column="1" Content="Search" Margin="8,0,0,0" Click="HistorySearchButton_Click"/>
                            <Button x:Name="HistoryRefreshButton" Grid.Column="2" Content="Refresh" Margin="8,0,0,0" Click="HistoryRefreshButton_Click"/>
                            <Button x:Name="HistoryClearButton" Grid.Column="3" Content="Clear All" Margin="8,0,0,0" Background="#374151" Click="HistoryClearButton_Click"/>
                        </Grid>
                        <ListBox x:Name="HistoryListBox" MaxHeight="450" Background="#18181B">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4">
                                        <TextBlock Grid.Column="0" Text="{Binding DateFormatted}" Width="140" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#F4F4F8" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Content="▶ Play" Margin="8,0,4,0" Padding="8,4" Background="#3B82F6" Foreground="White" FontSize="11" Click="OpenMediaFile_Click"/>
                                        <Button Grid.Column="3" Content="📁 Folder" Margin="4,0,0,0" Padding="8,4" Background="#374151" Foreground="White" FontSize="11" Click="ShowFolder_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- CONSOLE LOGS TAB -->
            <TabItem Header="Console Logs">
                <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,15,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="Backend Engine Logs" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F4F4F8" FontSize="15"/>
                            <CheckBox x:Name="AutoScrollCheck" Grid.Column="1" Content="Auto-Scroll" IsChecked="True" Margin="14,0,0,0" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            <CheckBox x:Name="MainLogWordWrapCheck" Grid.Column="2" Content="Wrap Lines" IsChecked="True" Margin="10,0,0,0" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" IsCheckedChanged="MainLogWordWrap_IsCheckedChanged"/>
                            <TextBox x:Name="LogsFilterBox" Grid.Column="3" Watermark="Search / filter logs..." Margin="14,0,10,0" TextChanged="LogsFilterBox_TextChanged"/>
                            <Button x:Name="SaveAllLogsButton" Grid.Column="4" Content="💾 Save Logs" Margin="0,0,8,0" Padding="10,6" Background="#374151" Foreground="White" Click="SaveAllLogsButton_Click"/>
                            <Button x:Name="CopyAllLogsButton" Grid.Column="5" Content="📋 Copy All" Margin="0,0,8,0" Padding="10,6" Background="#374151" Foreground="White" Click="CopyAllLogsButton_Click"/>
                            <Button x:Name="ClearLogsButton" Grid.Column="6" Content="🧹 Clear" Margin="0,0,8,0" Padding="10,6" Background="#374151" Foreground="White" Click="ClearLogsButton_Click"/>
                            <Button x:Name="PopOutLogsButton" Grid.Column="7" Content="↗ Pop Out" Padding="10,6" Background="#4F46E5" Foreground="White" FontWeight="SemiBold" Click="PopOutLogsButton_Click"/>
                        </Grid>

                        <!-- Main Log Terminal Box -->
                        <Border Grid.Row="1" Background="#090A0F" CornerRadius="6" BorderBrush="#27272A" BorderThickness="1" Padding="12" MinHeight="380">
                            <TextBox x:Name="MainLogTextBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                     FontSize="12"
                                     Foreground="#86EFAC"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Border>

                        <!-- Footer line with counter -->
                        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="MainLogCountLabel" Grid.Column="0" Text="0 log lines" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Live Real-time Diagnostics" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <Border Grid.Row="2" Background="#18181B" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <TextBlock x:Name="GlobalStatusText" Text="Ready" Foreground="#9CA3AF" FontSize="12"/>
        </Border>
    </Grid>
</Window>
