<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:UniversalDownloader.Core.Models;assembly=UniversalDownloader.Core"
        xmlns:local="clr-namespace:UniversalDownloader.Avalonia"
        x:Class="UniversalDownloader.Avalonia.MainWindow"
        Title="Universal Media Downloader"
        Icon="/Assets/app-icon.ico"
        Width="940" Height="740"
        WindowStartupLocation="CenterScreen"
        Background="#0E0E12">

    <Window.Resources>
        <!-- Standard Vector SVG Paths (No text emojis) -->
        <StreamGeometry x:Key="PasteIcon">M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M19,19H5V5H7V7H17V5H19V19Z</StreamGeometry>
        <StreamGeometry x:Key="InspectIcon">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</StreamGeometry>
        <StreamGeometry x:Key="CopyIcon">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
        <StreamGeometry x:Key="SaveIcon">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</StreamGeometry>
        <StreamGeometry x:Key="ClearIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="PopOutIcon">M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z</StreamGeometry>
        <StreamGeometry x:Key="RefreshIcon">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</StreamGeometry>
        <StreamGeometry x:Key="FolderBrowseIcon">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z</StreamGeometry>
        <StreamGeometry x:Key="FolderOpenIcon">M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8V18A2,2 0 0,1 19,20Z</StreamGeometry>
        <StreamGeometry x:Key="PlayIcon">M8,5.14V19.14L19,12.14L8,5.14Z</StreamGeometry>
        <StreamGeometry x:Key="DownloadLightningIcon">M11,15H6L13,1V9H18L11,23V15Z</StreamGeometry>
        <StreamGeometry x:Key="DownloadArrowIcon">M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z</StreamGeometry>
        <StreamGeometry x:Key="UserIcon">M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z</StreamGeometry>
        <StreamGeometry x:Key="EyeIcon">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</StreamGeometry>
        <StreamGeometry x:Key="ClockIcon">M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z</StreamGeometry>
        <StreamGeometry x:Key="InfoCircleIcon">M11,7H13V9H11V7M11,11H13V17H11V11M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20Z</StreamGeometry>
        <StreamGeometry x:Key="SpinnerIcon">M12,4V2A10,10 0 0,0 2,12H4A8,8 0 0,1 12,4Z</StreamGeometry>
        <StreamGeometry x:Key="UpdateIcon">M21,10.12H14.22L16.96,7.3C14.23,4.6 9.81,4.5 7.08,7.2C4.35,9.91 4.35,14.28 7.08,17C9.81,19.7 14.23,19.7 16.96,17C18.32,15.65 19,14.08 19,12.1H21C21,14.08 20.12,16.65 18.36,18.39C14.85,21.87 9.15,21.87 5.64,18.39C2.14,14.92 2.11,9.28 5.62,5.81C9.13,2.34 14.76,2.34 18.27,5.81L21,3V10.12M12.5,8V12.25L16,14.33L15.28,15.54L11,13V8H12.5Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="PathIcon.spinner">
            <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
            <Style.Animations>
                <Animation Duration="0:0:0.85" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="PathIcon.info-icon">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="PathIcon.info-icon:pointerover">
            <Setter Property="Foreground" Value="#38BDF8"/>
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="340"/>
        </Style>
    </Window.Styles>

    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="Auto,*">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image Source="/Assets/app-icon.png" Width="36" Height="36"/>
                <TextBlock x:Name="AppTitleText" Text="Universal Media Downloader" FontSize="20" FontWeight="Bold" Foreground="#F4F4F8" VerticalAlignment="Center"/>
                <Border Background="#27272A" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="AppVersionBadge" Text="v3.3.0" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="LanguageToggleButton" Padding="10,6" Background="#27272A" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Content="عربي" Click="LanguageToggleButton_Click" ToolTip.Tip="Switch interface language between English (LTR) and Arabic (RTL)"/>
                <Button x:Name="CheckUpdatesButton" Padding="10,6" Background="#27272A" Foreground="#E2E8F0" Click="CheckUpdatesButton_Click" ToolTip.Tip="Check GitHub Releases for a newer version of Universal Media Downloader">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon x:Name="CheckUpdatesIcon" Data="{StaticResource UpdateIcon}" Width="14" Height="14" Foreground="#38BDF8"/>
                        <PathIcon x:Name="CheckUpdatesSpinner" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="14" Height="14" Foreground="#38BDF8" IsVisible="False"/>
                        <TextBlock x:Name="CheckUpdatesText" Text="Check Updates" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- App Update Available Banner -->
        <Border x:Name="UpdateBanner" Grid.Row="1" IsVisible="False" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="UPDATE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="UpdateBannerMessage" Text="A newer version is available!" Foreground="#F4F4F8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button x:Name="DownloadUpdateButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,5" Background="#6366F1" Foreground="White" FontWeight="SemiBold" FontSize="11" Click="DownloadUpdateButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource DownloadArrowIcon}" Width="12" Height="12" Foreground="White"/>
                        <TextBlock Text="Download Update" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ViewReleaseNotesButton" Grid.Column="2" Margin="6,0,0,0" Padding="10,5" Background="#312E81" Foreground="#E2E8F0" FontSize="11" Content="Release Notes" Click="ViewReleaseNotesButton_Click"/>
                <Button x:Name="DismissUpdateButton" Grid.Column="3" Margin="6,0,0,0" Padding="8,4" Background="Transparent" Foreground="#94A3B8" FontSize="12" Content="✕" Click="DismissUpdateButton_Click"/>
            </Grid>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="MainTabControl" Grid.Row="2">
            <!-- DOWNLOAD TAB -->
            <TabItem x:Name="DownloadTab" Header="Download">
                <ScrollViewer Margin="0,15,0,0">
                    <StackPanel Spacing="16">
                        <!-- URL Input Card -->
                        <Border Background="#1E1E24" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock x:Name="MediaUrlHeader" Text="Media URL" FontWeight="SemiBold" Foreground="#F4F4F8"/>
                                    <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                              ToolTip.Tip="Enter or paste any media URL, playlist, or public post from 1,000+ supported platforms (YouTube, TikTok, Instagram, Facebook, X/Twitter, SoundCloud, Vimeo, Reddit, Twitch, etc.)."/>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox x:Name="UrlTextBox" Grid.Column="0" FlowDirection="LeftToRight" Watermark="Paste video, audio, or playlist URL here..." TextChanged="UrlTextBox_TextChanged"/>
                                    <Button x:Name="PasteButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,8" Click="PasteButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource PasteIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="PasteButtonText" Text="Paste" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="InspectButton" Grid.Column="2" Margin="8,0,0,0" Padding="12,8" Background="#374151" Click="InspectButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon x:Name="InspectIconPath" Data="{StaticResource InspectIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                            <PathIcon x:Name="InspectSpinner" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="13" Height="13" Foreground="#38BDF8" IsVisible="False"/>
                                            <TextBlock x:Name="InspectButtonText" Text="Inspect Streams" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <!-- Smart Clipboard Suggestion Banner -->
                                <Border x:Name="ClipboardBanner" IsVisible="False" Background="#162032" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="6" Padding="10,6">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock x:Name="ClipboardBannerText" Grid.Column="0" Text="Copied media URL detected" Foreground="#BAE6FD" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="AcceptClipboardButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,4" Background="#0284C7" Foreground="White" FontSize="11" FontWeight="SemiBold" Content="Paste &amp; Load" Click="AcceptClipboardButton_Click"/>
                                        <Button x:Name="DismissClipboardButton" Grid.Column="2" Margin="4,0,0,0" Padding="6,4" Background="Transparent" Foreground="#94A3B8" FontSize="11" Content="✕" Click="DismissClipboardButton_Click"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Media Metadata & Thumbnail Preview Card -->
                        <Border x:Name="MetadataCard" IsVisible="False" Background="#181820" CornerRadius="10" Padding="14" BorderBrush="#3B82F6" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <!-- Thumbnail Container -->
                                    <Border Grid.Column="0" Width="170" Height="96" CornerRadius="8" ClipToBounds="True" Background="#090A0F" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <Panel>
                                            <Image x:Name="ThumbnailImage" Stretch="UniformToFill"/>
                                            <PathIcon x:Name="ThumbnailSpinner" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="26" Height="26" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                                            <!-- Duration Badge overlay at bottom right -->
                                            <Border x:Name="DurationBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Background="#DD000000" CornerRadius="4" Padding="5,2" IsVisible="False">
                                                <TextBlock x:Name="DurationLabel" Text="00:00" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Panel>
                                    </Border>

                                    <!-- Metadata Details -->
                                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                        <!-- Platform & Status Badges -->
                                        <WrapPanel Orientation="Horizontal">
                                            <Border Background="#3B82F6" CornerRadius="4" Padding="6,2" Margin="0,0,6,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="PlatformBadge" Text="YOUTUBE" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Button x:Name="ProfileIdButton" IsVisible="False" Margin="0,0,6,3" Padding="7,2" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="4" Click="ProfileIdButton_Click" ToolTip.Tip="Click to copy Profile ID">
                                                <TextBlock x:Name="ProfileIdLabel" Text="ID: " Foreground="#7DD3FC" FontSize="10" FontWeight="SemiBold"/>
                                            </Button>
                                            <Border x:Name="ProfileVerifiedBadge" IsVisible="False" Background="#172554" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,3" VerticalAlignment="Center">
                                                <TextBlock Text="✓ VERIFIED" Foreground="#93C5FD" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Border x:Name="ProfileLockedBadge" IsVisible="False" Background="#451A03" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,6,3" VerticalAlignment="Center">
                                                <TextBlock x:Name="ProfileLockedBadgeText" Text="LOCKED PROFILE" Foreground="#FCD34D" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Button x:Name="CopyAllProfileInfoButton" IsVisible="False" Margin="0,0,6,3" Padding="7,2" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="4" Click="CopyAllProfileInfoButton_Click" ToolTip.Tip="Copy all public profile details to clipboard">
                                                <TextBlock x:Name="CopyAllProfileInfoText" Text="Copy All Info" Foreground="#C7D2FE" FontSize="10" FontWeight="SemiBold"/>
                                            </Button>
                                            <PathIcon x:Name="MetadataHeaderSpinner" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="12" Height="12" Foreground="#38BDF8" Margin="0,0,6,3" VerticalAlignment="Center" IsVisible="False"/>
                                            <TextBlock x:Name="MetadataLoadingText" Text="Loading media details..." Foreground="#94A3B8" FontSize="11" Margin="0,0,0,3" VerticalAlignment="Center" IsVisible="False"/>
                                        </WrapPanel>

                                        <!-- Title -->
                                        <TextBlock x:Name="VideoTitleLabel" Text="Video Title" FontSize="15" FontWeight="Bold" Foreground="#F4F4F8" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>

                                        <!-- Uploader / Channel & View Count -->
                                        <StackPanel Orientation="Horizontal" Spacing="14">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon Data="{StaticResource UserIcon}" Width="12" Height="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="UploaderLabel" Text="Channel Name" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon Data="{StaticResource EyeIcon}" Width="12" Height="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ViewsLabel" Text="" FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Click-to-Copy Public Profile Bio -->
                                        <Button x:Name="ProfileBioButton" IsVisible="False" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Click="ProfileBioButton_Click" ToolTip.Tip="Click to copy bio">
                                            <TextBlock x:Name="ProfileBioText" Text="" FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                        </Button>

                                        <!-- Click-to-Copy Public Profile Info Chips (ID, @handle, Followers, Likes, Posts, Channel ID, DID, etc.) -->
                                        <ItemsControl x:Name="ProfileInfoItems" IsVisible="False" Margin="0,2,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:ProfileInfoChipViewModel">
                                                    <Button Padding="7,2" Margin="0,0,5,4" CornerRadius="4"
                                                            Background="#162032"
                                                            BorderBrush="{Binding BorderHex}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="{Binding TooltipText}"
                                                            Click="ProfileInfoChip_Click">
                                                        <TextBlock Text="{Binding DisplayText}" Foreground="{Binding ForegroundHex}" FontSize="10" FontWeight="SemiBold"/>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Single-video Supported Qualities Pills -->
                                        <StackPanel x:Name="SingleVideoQualitiesPanel" IsVisible="False" Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                            <TextBlock x:Name="SupportedQualitiesLabel" Text="Qualities:" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                                            <ItemsControl x:Name="SingleVideoQualitiesItems">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Border Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,5,3">
                                                            <TextBlock Text="{Binding}" Foreground="#A7F3D0" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="MetadataProgressBar" IsIndeterminate="True" Height="3" Foreground="#38BDF8" IsVisible="False"/>
                            </StackPanel>
                        </Border>

                        <!-- Playlist Per-Video Cards Panel (Shown when URL is a playlist) -->
                        <Border x:Name="PlaylistCardsPanel" IsVisible="False" Background="#181820" CornerRadius="10" Padding="14" BorderBrush="#6366F1" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <!-- Playlist Header -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0" ClipToBounds="True">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <Border Grid.Column="0" Background="#6366F1" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="PlaylistPlatformBadge" Text="PLAYLIST" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                            </Border>
                                            <Border Grid.Column="1" Background="#27272A" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="PlaylistCountBadge" Text="0 videos" Foreground="#A5B4FC" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" x:Name="PlaylistTitleLabel" Text="Playlist Title" FontSize="15" FontWeight="Bold" Foreground="#F4F4F8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock x:Name="PlaylistUploaderLabel" Text="" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            <PathIcon x:Name="PlaylistScanSpinner" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="12" Height="12" Foreground="#38BDF8" VerticalAlignment="Center" IsVisible="False"/>
                                            <TextBlock x:Name="PlaylistScanStatusLabel" Text="" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button x:Name="LoadAllQualitiesButton" Grid.Column="1" IsVisible="False" Margin="0,0,8,0" Padding="10,6" Background="#27272A" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" Content="Load All Qualities" VerticalAlignment="Center" Click="LoadAllQualitiesButton_Click"/>
                                    <Button x:Name="QueueAllPlaylistButton" Grid.Column="2" Padding="12,6" Background="#4F46E5" Foreground="White" FontSize="12" FontWeight="SemiBold" Content="+ Add All to Queue" VerticalAlignment="Center" Click="QueueAllPlaylistButton_Click"/>
                                </Grid>

                                <!-- Scrollable List of Per-Video Cards -->
                                <ScrollViewer MaxHeight="440" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="PlaylistCardsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="local:PlaylistVideoCardModel">
                                                <Border Background="#121218" BorderBrush="#27272A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <!-- Thumbnail with index & duration overlays -->
                                                        <Border Grid.Column="0" Width="132" Height="74" CornerRadius="6" ClipToBounds="True" Background="#090A0F" Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <Panel>
                                                                <Image Source="{Binding ThumbnailBitmap}" Stretch="UniformToFill"/>
                                                                <PathIcon Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="20" Height="20" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsThumbnailLoading}"/>
                                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4" Background="#CC000000" CornerRadius="4" Padding="5,1">
                                                                    <TextBlock Text="{Binding IndexBadge}" Foreground="#E2E8F0" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Background="#DD000000" CornerRadius="4" Padding="5,1" IsVisible="{Binding HasDuration}">
                                                                    <TextBlock Text="{Binding DurationFormatted}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </Panel>
                                                        </Border>

                                                        <!-- Video Details & Supported Qualities -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,12,0" ClipToBounds="True">
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="#F4F4F8" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                                                            <TextBlock Text="{Binding Uploader}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>

                                                            <!-- Loading supported qualities indicator -->
                                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0" IsVisible="{Binding IsLoadingQualities}">
                                                                <PathIcon Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="11" Height="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Loading supported qualities..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                            </StackPanel>

                                                            <!-- Clickable supported quality pills -->
                                                            <ItemsControl ItemsSource="{Binding Qualities}" Margin="0,2,0,0" IsVisible="{Binding HasQualities}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="local:QualityOptionChip">
                                                                        <Button Padding="7,2" Margin="0,0,5,4" CornerRadius="4"
                                                                                Background="{Binding BackgroundHex}"
                                                                                BorderBrush="{Binding BorderHex}"
                                                                                BorderThickness="1"
                                                                                Foreground="{Binding ForegroundHex}"
                                                                                FontSize="11" FontWeight="SemiBold"
                                                                                Content="{Binding Label}"
                                                                                Click="PlaylistQualityChip_Click"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- On-demand load button for large playlists -->
                                                            <Button IsVisible="{Binding NeedsManualQualityLoad}" Padding="8,2" Margin="0,2,0,0" HorizontalAlignment="Left" Background="#27272A" Foreground="#38BDF8" FontSize="11" Content="Load Supported Qualities" Click="LoadCardQualities_Click"/>

                                                            <!-- Fallback text when qualities unavailable -->
                                                            <TextBlock Text="{Binding QualityStatusText}" IsVisible="{Binding ShowQualityStatusText}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                        </StackPanel>

                                                        <!-- Per-Video Actions -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6" Width="96">
                                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,5" Background="#6366F1" Foreground="White" FontSize="11" FontWeight="SemiBold" Click="DownloadPlaylistCard_Click">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                    <PathIcon Data="{StaticResource DownloadArrowIcon}" Width="11" Height="11" Foreground="White"/>
                                                                    <TextBlock Text="Download" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,5" Background="#27272A" Foreground="#E2E8F0" FontSize="11" Content="{Binding QueueButtonText}" Click="QueuePlaylistCard_Click"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Options Card -->
                        <Border x:Name="DownloadOptionsCard" IsVisible="False" Background="#1E1E24" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="DownloadOptionsHeader" Text="Download Options" FontWeight="SemiBold" Foreground="#F4F4F8"/>
                                <Grid ColumnDefinitions="*,*,*">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="QualityHeader" Text="Quality" Foreground="#9CA3AF" FontSize="12"/>
                                            <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                      ToolTip.Tip="Select the desired video resolution or audio extraction. 'Best Available' automatically chooses the highest quality stream provided by the source platform."/>
                                        </StackPanel>
                                        <ComboBox x:Name="QualityComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Best Available (Max)"/>
                                            <ComboBoxItem Content="1080p Full HD"/>
                                            <ComboBoxItem Content="720p HD"/>
                                            <ComboBoxItem Content="480p SD"/>
                                            <ComboBoxItem Content="Audio Only (MP3)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="CodecHeader" Text="Codec Preference" Foreground="#9CA3AF" FontSize="12"/>
                                            <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                      ToolTip.Tip="Preferred video compression codec:&#x0a;• Default (Auto): Source default stream.&#x0a;• H.264 / AVC1: Maximum compatibility with TVs, phones, and media players.&#x0a;• VP9: Efficient Google/YouTube codec for 2K/4K resolution.&#x0a;• AV1: Next-generation ultra-efficient compression."/>
                                        </StackPanel>
                                        <ComboBox x:Name="CodecComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Default (Auto)"/>
                                            <ComboBoxItem Content="H.264 / AVC1 (Universal)"/>
                                            <ComboBoxItem Content="VP9 (High Quality)"/>
                                            <ComboBoxItem Content="AV1 (Ultra Compressed)"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="FragmentsHeader" Text="Fragments" Foreground="#9CA3AF" FontSize="12"/>
                                            <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                      ToolTip.Tip="Number of concurrent stream chunks downloaded in parallel for DASH and HLS video streams (1 to 16). Higher values significantly accelerate download speeds on fast internet connections."/>
                                        </StackPanel>
                                        <NumericUpDown x:Name="FragmentsNumeric" Value="4" Minimum="1" Maximum="16"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Output Directory -->
                                <StackPanel Spacing="6" Margin="0,4,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="SaveDirHeader" Text="Save Directory" Foreground="#9CA3AF" FontSize="12"/>
                                        <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                  ToolTip.Tip="The local folder on your device where downloaded media files, playlists, and tracks will be stored. Defaults to your user Downloads folder."/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox x:Name="OutputDirBox" Grid.Column="0" FlowDirection="LeftToRight" Watermark="Default directory (or ~/Downloads)"/>
                                        <Button x:Name="BrowseDirButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,6" Click="BrowseDirButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource FolderBrowseIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                                <TextBlock x:Name="BrowseDirText" Text="Browse..." VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="OpenDirButton" Grid.Column="2" Margin="8,0,0,0" Padding="10,6" Background="#374151" Click="OpenDirButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource FolderOpenIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                                <TextBlock x:Name="OpenDirText" Text="Open" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>

                                <!-- Authentication / Cookies -->
                                <Grid ColumnDefinitions="220,*" Margin="0,4,0,0">
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="BrowserCookiesHeader" Text="Browser Cookies" Foreground="#9CA3AF" FontSize="12"/>
                                            <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                      ToolTip.Tip="Automatically read your signed-in session cookies from an installed browser to unlock age-restricted videos and load full native HD photos for profiles your account is authorized to view. (Tip: on Windows, Firefox cookies work even while open; for Chrome/Edge, close the browser or import cookies.txt.)"/>
                                        </StackPanel>
                                        <ComboBox x:Name="CookiesBrowserComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="None (Anonymous)"/>
                                            <ComboBoxItem Content="Chrome"/>
                                            <ComboBoxItem Content="Edge"/>
                                            <ComboBoxItem Content="Firefox"/>
                                            <ComboBoxItem Content="Brave"/>
                                            <ComboBoxItem Content="Opera"/>
                                            <ComboBoxItem Content="Vivaldi"/>
                                            <ComboBoxItem Content="Safari"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock x:Name="CookiesFileHeader" Text="Cookies File (cookies.txt)" Foreground="#9CA3AF" FontSize="12"/>
                                            <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                      ToolTip.Tip="Optional Netscape-format cookies.txt file exported from your browser. Overrides Browser Cookies when set."/>
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                            <TextBox x:Name="CookiesFileBox" Grid.Column="0" FlowDirection="LeftToRight" Watermark="Optional path to cookies.txt..."/>
                                            <Button x:Name="WebLoginButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,6" Background="#065F46" Foreground="#A7F3D0" FontWeight="SemiBold" Content="Web Login" Click="WebLoginButton_Click"
                                                    ToolTip.Tip="Sign in directly inside Chrome/Edge using a dedicated app login profile and sync cookies automatically — no manual copying needed!"/>
                                            <Button x:Name="PasteCookiesButton" Grid.Column="2" Margin="6,0,0,0" Padding="10,6" Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" Content="Paste Cookies" Click="PasteCookiesButton_Click"
                                                    ToolTip.Tip="Paste a raw Cookie header from Chrome/Edge DevTools or Netscape cookies.txt text — works even while Chrome is open!"/>
                                            <Button x:Name="BrowseCookiesButton" Grid.Column="3" Margin="6,0,0,0" Padding="10,6" Content="Browse..." Click="BrowseCookiesButton_Click"/>
                                            <Button x:Name="ClearCookiesButton" Grid.Column="4" Margin="6,0,0,0" Padding="8,6" Background="#374151" Content="✕" Click="ClearCookiesButton_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <WrapPanel Margin="0,6,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="EmbedMetadataCheck" Content="Embed Metadata" IsChecked="True"/>
                                        <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                  ToolTip.Tip="Embeds tags such as title, artist/uploader, publication date, description, and chapters directly into the media container file tags (ID3 / MP4 atoms)."/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="EmbedThumbnailCheck" Content="Embed Cover Art" IsChecked="True"/>
                                        <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                  ToolTip.Tip="Embeds the high-resolution thumbnail or cover image directly into the audio or video file as embedded album artwork."/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <CheckBox x:Name="EmbedSubsCheck" Content="Embed Subtitles" IsChecked="False"/>
                                        <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                  ToolTip.Tip="Embeds available subtitle tracks directly into video containers (MKV/MP4) using FFmpeg without burning them permanently into the video picture."/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <CheckBox x:Name="WriteThumbnailCheck" Content="Save Thumbnail File" IsChecked="False"/>
                                        <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                  ToolTip.Tip="Saves the original thumbnail image file (JPG/PNG/WebP) alongside the downloaded media in your destination folder."/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Collapsible Clip Trimmer, Playlist Picker & SponsorBlock -->
                                <Expander HorizontalAlignment="Stretch" Background="#16161C" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Margin="0,6,0,0">
                                    <Expander.Header>
                                        <TextBlock x:Name="AdvancedExpanderHeader" Text="Clip Trimmer, Playlist Selection &amp; SponsorBlock (Advanced)" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                    </Expander.Header>
                                    <StackPanel Spacing="10" Margin="4,8,4,4">
                                        <Grid ColumnDefinitions="*,*,*">
                                            <StackPanel Grid.Column="0" Margin="0,0,10,0" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock x:Name="StartTimeHeader" Text="Start Time" Foreground="#9CA3AF" FontSize="12"/>
                                                    <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                              ToolTip.Tip="Optional clip start timestamp (e.g. 00:01:30 or 90). Only downloads from this point onward."/>
                                                </StackPanel>
                                                <TextBox x:Name="StartTimeBox" FlowDirection="LeftToRight" Watermark="e.g. 00:00:30"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Margin="0,0,10,0" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock x:Name="EndTimeHeader" Text="End Time" Foreground="#9CA3AF" FontSize="12"/>
                                                    <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                              ToolTip.Tip="Optional clip end timestamp (e.g. 00:03:15 or 195). Cuts the video precisely at this timestamp using FFmpeg."/>
                                                </StackPanel>
                                                <TextBox x:Name="EndTimeBox" FlowDirection="LeftToRight" Watermark="e.g. 00:02:15"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Spacing="5">
                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                    <TextBlock x:Name="PlaylistItemsHeader" Text="Playlist Items" Foreground="#9CA3AF" FontSize="12"/>
                                                    <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                              ToolTip.Tip="Select specific items from a playlist by index or range (e.g. 1,3,5-8). Leave empty to download all."/>
                                                </StackPanel>
                                                <TextBox x:Name="PlaylistItemsBox" FlowDirection="LeftToRight" Watermark="e.g. 1,2,5-8"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <CheckBox x:Name="SponsorBlockCheck" Content="Remove SponsorBlock Segments (sponsor, intro, outro, selfpromo)" IsChecked="False"/>
                                            <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                      ToolTip.Tip="Automatically cuts out crowd-sourced sponsored segments, intros, outros, and self-promotions from YouTube videos using SponsorBlock."/>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>

                        <!-- Action Bar -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <Button x:Name="DownloadButton" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#6366F1" Foreground="White" Padding="14" FontWeight="Bold" Click="DownloadButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource DownloadArrowIcon}" Width="16" Height="16" Foreground="White"/>
                                    <TextBlock x:Name="StartDownloadText" Text="Start Download" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ProfilePicButton" Grid.Column="1" Margin="10,0,0,0" Background="#1E293B" Foreground="#E2E8F0" Padding="14" FontWeight="SemiBold" Click="ProfilePicButton_Click"
                                    ToolTip.Tip="Download a profile picture from a public URL or platform:username (e.g. instagram:user, facebook:user, tiktok:user, x:user). Uses your configured Browser Cookies or cookies.txt for profiles your account is authorized to view.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon x:Name="ProfilePicIcon" Data="{StaticResource UserIcon}" Width="14" Height="14" Foreground="#38BDF8"/>
                                    <PathIcon x:Name="ProfilePicSpinner" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="14" Height="14" Foreground="#38BDF8" IsVisible="False"/>
                                    <TextBlock x:Name="ProfilePicButtonText" Text="Profile Pic" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AddToQueueButton" Grid.Column="2" Margin="10,0,0,0" Background="#374151" Foreground="White" Padding="14" FontWeight="SemiBold" Content="+ Add to Queue" Click="AddToQueueButton_Click" ToolTip.Tip="Add this URL with your current options to the batch Download Queue"/>
                            <Button x:Name="CancelButton" Grid.Column="3" Content="Cancel" Margin="10,0,0,0" Background="#EF4444" Foreground="White" Padding="14" IsEnabled="False" Click="CancelButton_Click"/>
                        </Grid>

                        <!-- Real-time Progress Card -->
                        <Border x:Name="ProgressCard" IsVisible="False" Background="#1E1E24" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="Downloading..." FontWeight="SemiBold" Foreground="#F4F4F8"/>
                                    <TextBlock x:Name="PercentLabel" Grid.Column="1" Text="0.0%" FontWeight="Bold" Foreground="#6366F1"/>
                                </Grid>
                                <ProgressBar x:Name="DownloadProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#6366F1"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="DetailsLabel" Grid.Column="0" Text="0 B / 0 B • 0 B/s" FontSize="12" Foreground="#9CA3AF"/>
                                    <TextBlock x:Name="EtaLabel" Grid.Column="1" Text="ETA: --:--" FontSize="12" Foreground="#9CA3AF"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Inline Terminal Logs with Individual Colors -->
                        <Border Background="#1E1E24" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="LiveTerminalHeader" Text="Live Terminal Output" FontWeight="SemiBold" Foreground="#F4F4F8" VerticalAlignment="Center"/>
                                        <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                                  ToolTip.Tip="Real-time console output from the downloader engine, displaying download milestones, FFmpeg multiplexing, and diagnostic messages."/>
                                    </StackPanel>
                                    <Button x:Name="QuickCopyLogsButton" Grid.Column="1" Padding="10,4" FontSize="11" Background="#27272A" Foreground="#E2E8F0" Click="QuickCopyLogsButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <PathIcon Data="{StaticResource CopyIcon}" Width="11" Height="11" Foreground="#94A3B8"/>
                                            <TextBlock x:Name="QuickCopyText" Text="Copy Output" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Border Background="#090A0F" CornerRadius="6" BorderBrush="#27272A" BorderThickness="1" Padding="6" Height="160" FlowDirection="LeftToRight">
                                    <ListBox x:Name="QuickLogListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="4,2"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:LogMessage">
                                                <SelectableTextBlock Text="{Binding FormattedText}"
                                                                     Foreground="{Binding ColorHex}"
                                                                     FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                                                     FontSize="11"
                                                                     TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- DOWNLOAD QUEUE TAB -->
            <TabItem x:Name="QueueTab" Header="Queue">
                <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,15,0,0">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <!-- Batch URL Input -->
                        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="QueueHeaderLabel" Text="Batch Download Queue" FontWeight="Bold" FontSize="15" Foreground="#F4F4F8"/>
                                <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                          ToolTip.Tip="Paste one or more media URLs (one per line) to enqueue them with your current Download Options and run them automatically in parallel."/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="QueueBatchUrlsBox" Grid.Column="0" FlowDirection="LeftToRight" AcceptsReturn="True" Height="62" Watermark="Paste multiple URLs here (one per line) to add to the queue..."/>
                                <Button x:Name="QueueAddBatchButton" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Stretch" Padding="14,6" Background="#374151" Foreground="White" FontWeight="SemiBold" Content="+ Add URLs" Click="QueueAddBatchButton_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Queue Controls -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,0,0,12">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="QueueParallelLabel" Text="Parallel:" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                                <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                          ToolTip.Tip="Number of queued downloads executed simultaneously (1 to 3)."/>
                            </StackPanel>
                            <NumericUpDown x:Name="QueueConcurrencyNumeric" Grid.Column="1" Value="2" Minimum="1" Maximum="3" Width="96" Margin="8,0,0,0"/>
                            <TextBlock x:Name="QueueSummaryLabel" Grid.Column="2" Text="0 items in queue" Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="StartQueueButton" Grid.Column="3" Margin="0,0,8,0" Padding="12,6" Background="#6366F1" Foreground="White" FontWeight="Bold" Content="Start Queue" Click="StartQueueButton_Click"/>
                            <Button x:Name="StopQueueButton" Grid.Column="4" Margin="0,0,8,0" Padding="12,6" Background="#EF4444" Foreground="White" IsEnabled="False" Content="Stop" Click="StopQueueButton_Click"/>
                            <Button x:Name="ClearQueueButton" Grid.Column="5" Padding="10,6" Background="#374151" Foreground="White" Content="Clear Completed" Click="ClearQueueButton_Click"/>
                        </Grid>

                        <!-- Queue Items -->
                        <ListBox x:Name="QueueListBox" Grid.Row="2" Background="#14141A" CornerRadius="6" Padding="4" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:QueueItemModel">
                                    <Border Background="#1E1E24" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                        <Grid ColumnDefinitions="*,130,Auto">
                                            <Grid Grid.Column="0" RowDefinitions="Auto,Auto" Margin="0,0,12,0" ClipToBounds="True">
                                                <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,4">
                                                    <Border Grid.Column="0" Background="#27272A" CornerRadius="4" Padding="6,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusColorHex}" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Grid.Column="1" Background="#1E1B4B" BorderBrush="#4F46E5" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding QualityBadgeText}" Foreground="#A5B4FC" FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Title}" Foreground="#F4F4F8" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding StatusDetail}" Foreground="#94A3B8" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusDetail}"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="0,0,10,0">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="6" Foreground="#6366F1"/>
                                                <TextBlock Text="{Binding ProgressText}" Foreground="#9CA3AF" FontSize="10" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" VerticalAlignment="Center" Padding="8,4" Background="#27272A" Foreground="#EF4444" FontSize="11" Content="✕" Click="RemoveQueueItem_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </TabItem>

            <!-- STREAMS EXPLORER TAB -->
            <TabItem x:Name="StreamsTab" Header="Streams">
                <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,15,0,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="StreamsStatusHeader" Text="Inspect a media URL on the Download tab to view all formats." FontWeight="SemiBold" Foreground="#F4F4F8" VerticalAlignment="Center"/>
                                <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                          ToolTip.Tip="Inspects the URL without downloading to reveal all video and audio streams, codecs, and resolutions available on the hosting platform."/>
                            </StackPanel>
                            <Button x:Name="RefreshStreamsButton" Grid.Column="1" Padding="10,6" Background="#374151" Foreground="White" Click="InspectButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon x:Name="RefreshStreamsIconPath" Data="{StaticResource RefreshIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                    <PathIcon x:Name="RefreshStreamsSpinner" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="13" Height="13" Foreground="#38BDF8" IsVisible="False"/>
                                    <TextBlock x:Name="RefreshStreamsButtonText" Text="Refresh Streams" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Platform Notice / Locked Profile Banner -->
                        <Border x:Name="StreamsNoticeBanner" IsVisible="False" Background="#2B1F0E" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <TextBlock x:Name="StreamsNoticeText" Text="" Foreground="#FDE68A" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Animated Loading State for Stream Inspection -->
                        <Border x:Name="StreamsLoadingPanel" IsVisible="False" Background="#14141A" CornerRadius="8" Padding="24" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <PathIcon Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="20" Height="20" Foreground="#38BDF8"/>
                                    <TextBlock x:Name="StreamsLoadingLabel" Text="Inspecting available video &amp; audio streams..." Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar IsIndeterminate="True" Width="280" Height="4" Foreground="#6366F1"/>
                            </StackPanel>
                        </Border>

                        <ListBox x:Name="StreamsListBox" MaxHeight="450" Background="#18181B" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="local:StreamItemViewModel">
                                    <Grid ColumnDefinitions="Auto,190,*,110,Auto" Margin="6,4">
                                        <!-- Live Image Thumbnail Preview (shown for discovered pictures) -->
                                        <Border Grid.Column="0" IsVisible="{Binding IsImage}" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="#090A0F" BorderBrush="#27272A" BorderThickness="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Panel>
                                                <Image Source="{Binding PreviewBitmap}" Stretch="UniformToFill"/>
                                                <PathIcon Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="14" Height="14" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoadingPreview}"/>
                                            </Panel>
                                        </Border>
                                        <!-- Resolution / Type and Extension Badge -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResolutionFormatted}" FontWeight="Bold" Foreground="#A7F3D0" VerticalAlignment="Center"/>
                                            <Border Background="#27272A" CornerRadius="4" Padding="5,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Extension}" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <!-- Codecs & Note -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding CodecSummary}" Foreground="#F4F4F8" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FormatNote}" Foreground="#6B7280" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <!-- File size -->
                                        <TextBlock Grid.Column="3" Text="{Binding FilesizeFormatted}" VerticalAlignment="Center" Foreground="#CBD5E1" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                        <!-- Download button -->
                                        <Button Grid.Column="4" Padding="10,5" Background="#6366F1" Foreground="White" FontWeight="SemiBold" FontSize="11" Click="DownloadStream_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource DownloadLightningIcon}" Width="11" Height="11" Foreground="White"/>
                                                <TextBlock Text="Download" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- HISTORY TAB -->
            <TabItem x:Name="HistoryTab" Header="History">
                <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,15,0,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <TextBox x:Name="HistorySearchBox" Grid.Column="0" Watermark="Search history..."/>
                            <Button x:Name="HistorySearchButton" Grid.Column="1" Margin="8,0,0,0" Padding="10,6" Click="HistorySearchButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource InspectIcon}" Width="12" Height="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="Search" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="HistoryRefreshButton" Grid.Column="2" Margin="8,0,0,0" Padding="10,6" Click="HistoryRefreshButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource RefreshIcon}" Width="12" Height="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="HistoryClearButton" Grid.Column="3" Margin="8,0,0,0" Padding="10,6" Background="#374151" Click="HistoryClearButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource ClearIcon}" Width="12" Height="12" Foreground="#EF4444"/>
                                    <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <ProgressBar x:Name="HistoryLoadingBar" IsIndeterminate="True" Height="3" Foreground="#38BDF8" IsVisible="False"/>
                        <ListBox x:Name="HistoryListBox" MaxHeight="450" Background="#18181B" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:HistoryRecordModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="4">
                                        <TextBlock Grid.Column="0" Text="{Binding DateFormatted}" Width="140" VerticalAlignment="Center" Foreground="#9CA3AF"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Medium" Foreground="#F4F4F8" TextTrimming="CharacterEllipsis"/>
                                        <Button Grid.Column="2" Margin="8,0,4,0" Padding="8,4" Background="#3B82F6" Foreground="White" FontSize="11" Click="OpenMediaFile_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource PlayIcon}" Width="10" Height="10" Foreground="White"/>
                                                <TextBlock Text="Play" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="3" Margin="4,0,0,0" Padding="8,4" Background="#374151" Foreground="White" FontSize="11" Click="ShowFolder_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource FolderOpenIcon}" Width="10" Height="10" Foreground="#CBD5E1"/>
                                                <TextBlock Text="Folder" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- CONSOLE LOGS TAB WITH INDIVIDUAL LINE COLORS -->
            <TabItem x:Name="LogsTab" Header="Console Logs">
                <Border Background="#1E1E24" CornerRadius="8" Padding="16" Margin="0,15,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="BackendLogsHeader" Text="Backend Engine Logs" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F4F4F8" FontSize="15"/>
                                <PathIcon Classes="info-icon" Data="{StaticResource InfoCircleIcon}"
                                          ToolTip.Tip="Full console log output with real-time text filtering, search, export to file, and pop-out multi-window support."/>
                            </StackPanel>
                            <CheckBox x:Name="AutoScrollCheck" Grid.Column="1" Content="Auto-Scroll" IsChecked="True" Margin="14,0,0,0" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox x:Name="LogsFilterBox" Grid.Column="2" Watermark="Search / filter logs..." Margin="14,0,10,0" TextChanged="LogsFilterBox_TextChanged"/>
                            <Button x:Name="SaveAllLogsButton" Grid.Column="3" Margin="0,0,8,0" Padding="10,6" Background="#374151" Foreground="White" Click="SaveAllLogsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource SaveIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="SaveAllLogsText" Text="Save Logs" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyAllLogsButton" Grid.Column="4" Margin="0,0,8,0" Padding="10,6" Background="#374151" Foreground="White" Click="CopyAllLogsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource CopyIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="CopyAllLogsText" Text="Copy All" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ClearLogsButton" Grid.Column="5" Margin="0,0,8,0" Padding="10,6" Background="#374151" Foreground="White" Click="ClearLogsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource ClearIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="PopOutLogsButton" Grid.Column="6" Padding="10,6" Background="#4F46E5" Foreground="White" FontWeight="SemiBold" Click="PopOutLogsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource PopOutIcon}" Width="13" Height="13" Foreground="White"/>
                                    <TextBlock Text="Pop Out" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Main Log Terminal with Color Coding -->
                        <Border Grid.Row="1" Background="#090A0F" CornerRadius="6" BorderBrush="#27272A" BorderThickness="1" Padding="6" MinHeight="380">
                            <ListBox x:Name="MainLogListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="4,1"/>
                                        <Setter Property="MinHeight" Value="18"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#1E1B4B"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:LogMessage">
                                        <SelectableTextBlock Text="{Binding FormattedText}"
                                                             Foreground="{Binding ColorHex}"
                                                             FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                                             FontSize="12"
                                                             TextWrapping="Wrap"
                                                             SelectionBrush="#4F46E5"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Footer line with counter -->
                        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="MainLogCountLabel" Grid.Column="0" Text="0 log lines" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Live Real-time Diagnostics" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Status Footer -->
        <Border Grid.Row="3" Background="#18181B" CornerRadius="6" Padding="10" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <PathIcon x:Name="GlobalSpinner" Grid.Column="0" Classes="spinner" Data="{StaticResource SpinnerIcon}" Width="14" Height="14" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="False"/>
                <TextBlock x:Name="GlobalStatusText" Grid.Column="1" Text="Ready" Foreground="#9CA3AF" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="GlobalActivityBar" Grid.Column="2" IsIndeterminate="True" Width="90" Height="4" Foreground="#6366F1" VerticalAlignment="Center" Margin="10,0,0,0" IsVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
