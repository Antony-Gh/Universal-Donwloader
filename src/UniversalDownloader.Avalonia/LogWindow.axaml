<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:UniversalDownloader.Core.Models;assembly=UniversalDownloader.Core" x:Class="UniversalDownloader.Avalonia.LogWindow" Title="Universal Downloader — Live Execution Logs" Icon="/Assets/app-icon.ico" Width="920" Height="580" WindowStartupLocation="CenterOwner" Background="#0D0D11">

    <Window.Resources>
        <!-- Standard Vector SVG Paths -->
        <StreamGeometry x:Key="SaveIcon">M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z</StreamGeometry>
        <StreamGeometry x:Key="CopyIcon">M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z</StreamGeometry>
        <StreamGeometry x:Key="ClearIcon">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</StreamGeometry>
        <StreamGeometry x:Key="CheckIcon">M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z</StreamGeometry>
    </Window.Resources>

    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Column="0" Text="Console Logs" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F4F4F8" FontSize="16"/>
            <TextBox x:Name="FilterBox" Grid.Column="1" Watermark="Filter logs..." Margin="16,0,12,0" TextChanged="FilterBox_TextChanged"/>
            <CheckBox x:Name="AutoScrollCheck" Grid.Column="2" Content="Auto-scroll" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <Button x:Name="SaveButton" Grid.Column="3" Margin="0,0,8,0" Padding="12,6" Background="#374151" Foreground="White" Click="SaveButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource SaveIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                    <TextBlock x:Name="SaveButtonText" Text="Save Logs" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CopyButton" Grid.Column="4" Margin="0,0,8,0" Padding="12,6" Background="#374151" Foreground="White" Click="CopyButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon x:Name="CopyButtonIcon" Data="{StaticResource CopyIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                    <TextBlock x:Name="CopyButtonText" Text="Copy All" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="ClearButton" Grid.Column="5" Padding="12,6" Background="#374151" Foreground="White" Click="ClearButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource ClearIcon}" Width="13" Height="13" Foreground="#94A3B8"/>
                    <TextBlock Text="Clear" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Log Area with Individual Line Colors -->
        <Border Grid.Row="1" Background="#07090E" CornerRadius="6" BorderBrush="#1F2937" BorderThickness="1" Padding="6">
            <ListBox x:Name="LogListBox" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="4,1"/>
                        <Setter Property="MinHeight" Value="18"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                        <Setter Property="Background" Value="#1E1B4B"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:LogMessage">
                        <SelectableTextBlock Text="{Binding FormattedText}" Foreground="{Binding ColorHex}" FontFamily="Cascadia Code, Consolas, Courier New, monospace" FontSize="12" TextWrapping="Wrap" SelectionBrush="#4F46E5"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Status Footer -->
        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="LogCountLabel" Grid.Column="0" Text="0 lines" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="Universal Downloader v1.4.0" Foreground="#6B7280" FontSize="11" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
