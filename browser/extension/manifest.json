{
  "manifest_version": 3,
  "name": "Universal Media Downloader Companion",
  "short_name": "Universal Downloader",
  "version": "3.6.0",
  "description": "1-click Video & MP3 download, page stream sniffer (.m3u8 / .mpd / <video>), and Native Messaging companion for Universal Media Downloader.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Universal Media Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "universal-downloader@antony-gh.github.io",
      "strict_min_version": "109.0"
    }
  }
}
